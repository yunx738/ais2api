diff --git a/internal/app/build_raw.go b/internal/app/build_raw.go
new file mode 100644
index 0000000..90a8e3d
--- /dev/null
+++ b/internal/app/build_raw.go
@@ -0,0 +1,38 @@
+package app
+
+// dual-runtime 补丁：把写代码助手直通调用接到当前生成服务
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/Mag1cFall/AIStudio2API/internal/aistudio"
+)
+
+// BuildRaw 由当前生成服务执行直通调用
+func (manager *runtimeManager) BuildRaw(ctx context.Context, call aistudio.BuildRawCall) (aistudio.BuildRawResult, error) {
+	manager.mu.RLock()
+	defer manager.mu.RUnlock()
+	if manager.current == nil || manager.current.service == nil {
+		return aistudio.BuildRawResult{}, fmt.Errorf("生成服务未启动")
+	}
+	service, ok := manager.current.service.(aistudio.BuildRawService)
+	if !ok {
+		return aistudio.BuildRawResult{}, fmt.Errorf("生成服务不支持直通调用")
+	}
+	return service.BuildRaw(ctx, call)
+}
+
+// BuildRaw 转交给账户池服务
+func (service *trackedService) BuildRaw(ctx context.Context, call aistudio.BuildRawCall) (aistudio.BuildRawResult, error) {
+	raw, ok := service.service.(aistudio.BuildRawService)
+	if !ok {
+		return aistudio.BuildRawResult{}, fmt.Errorf("账户池服务不支持直通调用")
+	}
+	return raw.BuildRaw(ctx, call)
+}
+
+// DownloadAssistantFile 将应用文件下载委托给同一认证传输
+func (transport *authRetryTransport) DownloadAssistantFile(ctx context.Context, accountID string, applet string, hash string) (int, []byte, error) {
+	return transport.transport.(aistudio.AssistantFileDownloader).DownloadAssistantFile(ctx, accountID, applet, hash)
+}
