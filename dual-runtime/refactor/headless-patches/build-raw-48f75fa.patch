index 0000000..2dc9fd9
--- /dev/null
+++ b/internal/api/build_raw.go
@@ -0,0 +1,63 @@
+package api
+
+// dual-runtime 补丁：POST /v1/x-build-raw 写代码助手直通调用，只供本机网关使用：除公开 API key 外，还要求来源为回环地址并带 X-Build-Raw-Key（环境变量 BUILD_RAW_KEY，未配置则接口关闭）
+
+import (
+	"crypto/subtle"
+	"errors"
+	"net"
+	"net/http"
+	"os"
+
+	"github.com/Mag1cFall/AIStudio2API/internal/aistudio"
+)
+
+// buildRawAllowed 要求本机来源与内部 key；BUILD_RAW_KEY 为空时视为未启用
+func buildRawAllowed(r *http.Request) bool {
+	key := os.Getenv("BUILD_RAW_KEY")
+	if len(key) < 16 {
+		return false
+	}
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil {
+		return false
+	}
+	if ip := net.ParseIP(host); ip == nil || !ip.IsLoopback() {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(r.Header.Get("X-Build-Raw-Key")), []byte(key)) == 1
+}
+
+func (s *server) handleBuildRaw(w http.ResponseWriter, r *http.Request) {
+	if !buildRawAllowed(r) {
+		http.NotFound(w, r)
+		return
+	}
+	service, ok := s.service.(aistudio.BuildRawService)
+	if !ok {
+		writeOpenAIError(w, http.StatusNotImplemented, "build_raw_unsupported", "build raw is not supported")
+		return
+	}
+	var call aistudio.BuildRawCall
+	if err := decodeJSON(r, &call); err != nil {
+		writeOpenAIError(w, http.StatusBadRequest, "invalid_json", err.Error())
+		return
+	}
+	result, err := service.BuildRaw(r.Context(), call)
+	if err != nil {
+		status, code := http.StatusBadGateway, "build_raw_failed"
+		switch {
+		case errors.Is(err, aistudio.ErrInvalidArgument):
+			status, code = http.StatusBadRequest, "invalid_argument"
+		case errors.Is(err, aistudio.ErrAccountNotFound):
+			status, code = http.StatusNotFound, "account_not_found"
+		case errors.Is(err, aistudio.ErrNoEligibleAccount), errors.Is(err, aistudio.ErrAccountCoolingDown):
+			status, code = http.StatusServiceUnavailable, "account_unavailable"
+		case r.Context().Err() != nil:
+			status, code = 499, "client_closed"
+		}
+		writeOpenAIError(w, status, code, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusOK, result)
+}
